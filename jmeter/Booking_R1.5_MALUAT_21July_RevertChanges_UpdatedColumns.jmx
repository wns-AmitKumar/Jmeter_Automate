        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def sample = sampleEvent.getResult()

def timestamp = sample.getTimeStamp()
def elapsed = sample.getTime()
def label = sample.getSampleLabel()
def responseCode = sample.getResponseCode()
def responseMessage = sample.getResponseMessage()
def threadName = sample.getThreadName()
def dataType = sample.getDataType()
def success = sample.isSuccessful()
def failureMessage = sample.getResponseMessage()
def bytes = sample.getBytesAsLong()
def sentBytes = sample.getSentBytes()
def grpThreads = sample.getGroupThreads()
def allThreads = sample.getAllThreads()
def url = sample.getURL() != null ? sample.getURL().toString() : &quot;&quot;
def latency = sample.getLatency()
def idleTime = sample.getIdleTime()
def connect = sample.getConnectTime()


// Verify that values are being captured
log.info(&quot;======================================&quot;)
log.info(&quot;Timestamp      : &quot; + timestamp)
log.info(&quot;Label          : &quot; + label)
log.info(&quot;Elapsed        : &quot; + elapsed)
log.info(&quot;Response Code  : &quot; + responseCode)
log.info(&quot;Response Msg   : &quot; + responseMessage)
log.info(&quot;Thread         : &quot; + threadName)
log.info(&quot;Success        : &quot; + success)
log.info(&quot;Bytes          : &quot; + bytes)
log.info(&quot;Sent Bytes     : &quot; + sentBytes)
log.info(&quot;Group Threads  : &quot; + grpThreads)
log.info(&quot;All Threads    : &quot; + allThreads)
log.info(&quot;URL            : &quot; + url)
log.info(&quot;Latency        : &quot; + latency)
log.info(&quot;Idle Time      : &quot; + idleTime)
log.info(&quot;Connect Time   : &quot; + connect)
log.info(&quot;======================================&quot;)

def measurement = &quot;custom_jmeter_metrics1&quot;

def safeLabel = label.replaceAll(&quot;[ ,]&quot;, &quot;_&quot;)
def safeThread = threadName.replaceAll(&quot;[ ,]&quot;, &quot;_&quot;)
def safeResponseMessage = responseMessage.replace(&quot;\&quot;&quot;, &quot;&apos;&quot;)
def safeFailureMessage = failureMessage.replace(&quot;\&quot;&quot;, &quot;&apos;&quot;)
def safeUrl = url.replace(&quot;\&quot;&quot;, &quot;&apos;&quot;)

def line = &quot;${measurement},&quot; +
        &quot;label=${safeLabel},&quot; +
        &quot;thread=${safeThread} &quot; +
        &quot;elapsed=${elapsed},&quot; +
        &quot;responseCode=\&quot;${responseCode}\&quot;,&quot; +
        &quot;responseMessage=\&quot;${safeResponseMessage}\&quot;,&quot; +
        &quot;success=${success},&quot; +
        &quot;bytes=${bytes},&quot; +
        &quot;sentBytes=${sentBytes},&quot; +
        &quot;grpThreads=${grpThreads},&quot; +
        &quot;allThreads=${allThreads},&quot; +
        &quot;latency=${latency},&quot; +
        &quot;idleTime=${idleTime},&quot; +
        &quot;connect=${connect},&quot; +
        &quot;dataType=\&quot;${dataType}\&quot;,&quot; +
        &quot;failureMessage=\&quot;${safeFailureMessage}\&quot;,&quot; +
        &quot;url=\&quot;${safeUrl}\&quot; &quot; +
        &quot;${timestamp}000000&quot;

log.info(&quot;Influx Line = &quot; + line)

log.info(&quot;Influx Line = &quot; + line)

import java.net.HttpURLConnection
import java.net.URL

def influxUrl = &quot;http://localhost:8086/write?db=MalkomDashboard&quot;

def connection = (HttpURLConnection) new URL(influxUrl).openConnection()

connection.setRequestMethod(&quot;POST&quot;)
connection.setDoOutput(true)
connection.setRequestProperty(&quot;Content-Type&quot;, &quot;text/plain&quot;)

connection.outputStream.withWriter(&quot;UTF-8&quot;) { writer -&gt;
    writer.write(line)
}

def responseCodeInflux = connection.getResponseCode()

log.info(&quot;InfluxDB response code: &quot; + responseCodeInflux)

connection.disconnect()

</stringProp>
        </JSR223Listener>
