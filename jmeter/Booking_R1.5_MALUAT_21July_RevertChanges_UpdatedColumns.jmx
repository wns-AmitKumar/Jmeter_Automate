            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="Escape Returns" enabled="true">
              <stringProp name="script">String[] params= {&quot;UUID&quot;, &quot;CONTEXT&quot;, &quot;CID_8333CDBAB40A98C14806DDAC91E84583&quot;, &quot;CID_4713416CA9EC5E98A7BE1D09B03BC84F&quot;, &quot;CID_44A7926BB6F6110EDD4075EAB3F01B36&quot;, &quot;CID_D9D6F55C2AAABB5FD3A32C4E02258640&quot;, &quot;CID_DE7045E7C4F9E045F23FF37C6274AC6A&quot;, &quot;CID_57F59FA5EFEB4B6F01E4930BE20E35AD&quot;, &quot;SAVE_INTO_8333CDBAB40A98C14806DDAC91E84583&quot;, &quot;SAVE_INTO_4713416CA9EC5E98A7BE1D09B03BC84F&quot;, &quot;SAVE_INTO_44A7926BB6F6110EDD4075EAB3F01B36&quot;, &quot;SAVE_INTO_D9D6F55C2AAABB5FD3A32C4E02258640&quot;, &quot;SAVE_INTO_DE7045E7C4F9E045F23FF37C6274AC6A&quot;, &quot;SAVE_INTO_57F59FA5EFEB4B6F01E4930BE20E35AD&quot;};&#xd;
String param = &quot;&quot;;&#xd;
for(i = 0; i &lt; params.length;i++) {&#xd;
  param = vars.get(params[i]);&#xd;
  param = param.replaceAll(&quot;\\r\\n&quot;, &quot;\\\\r\\\\n&quot;);&#xd;
  vars.put(params[i], param);&#xd;
}</stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
